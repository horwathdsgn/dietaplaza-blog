{{- $index := slice -}}
{{- range where .Site.RegularPages "Section" "posts" -}}
  {{- $index = $index | append (dict
    "title" .Title
    "description" .Params.description
    "url" .RelPermalink
    "date" (.Date | time.Format ":date_long")
    "category" (index .Params.categories 0)
    "image" .Params.image
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
